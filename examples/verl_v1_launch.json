{
  "runtime": {
    "ray_address": "auto"
  },
  "controller": {
    "bind_host": "0.0.0.0",
    "advertise_host": "REPLACE_CONTROLLER_IP",
    "port": 8080,
    "startup_timeout_s": 900,
    "shutdown_timeout_s": 900
  },
  "deployment": {
    "id": "verl-rollout",
    "replicas": 1,
    "core_template": "verl_v1_core.template.json"
  },
  "model": {
    "path": "/shared/models/REPLACE_IMMUTABLE_MODEL",
    "shared_immutable": true,
    "initial_version": 0
  },
  "verl": {
    "base_config": "ppo_trainer",
    "trainer_nodes": 1,
    "trainer_npus_per_node": 2,
    "actor_mini_batch_size": 1,
    "parameter_sync_step": 1,
    "shutdown_timeout_s": 120,
    "overrides": [
      "data.train_files=/shared/data/REPLACE_TRAIN.parquet",
      "data.val_files=/shared/data/REPLACE_VALIDATION.parquet",
      "trainer.total_training_steps=3",
      "trainer.test_freq=-1",
      "trainer.save_freq=-1",
      "trainer.val_before_train=false",
      "trainer.logger=[console]",
      "actor_rollout_ref.rollout.n=1"
    ]
  },
  "smoke": {
    "prompt_ids": [1, 2]
  }
}
