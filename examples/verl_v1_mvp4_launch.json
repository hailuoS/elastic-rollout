{
  "runtime": {
    "ray_address": "auto"
  },
  "controller": {
    "bind_host": "0.0.0.0",
    "advertise_host": "REPLACE_CONTROLLER_IP",
    "port": 8080,
    "startup_timeout_s": 900,
    "shutdown_timeout_s": 900
  },
  "deployment": {
    "id": "mvp4",
    "core_template": "runtime.mvp4.example.json"
  },
  "model": {
    "path": "/shared/models/REPLACE_IMMUTABLE_MODEL",
    "initial_version": 0
  },
  "verl": {
    "shutdown_timeout_s": 120,
    "overrides": [
      "data.train_files=/shared/data/REPLACE_TRAIN.parquet",
      "data.val_files=/shared/data/REPLACE_VALIDATION.parquet",
      "data.train_batch_size=16",
      "trainer.device=npu",
      "trainer.resume_mode=disable",
      "trainer.nnodes=1",
      "trainer.n_gpus_per_node=2",
      "trainer.v1.separate_async.parameter_sync_step=1",
      "trainer.total_training_steps=100",
      "trainer.test_freq=-1",
      "trainer.save_freq=-1",
      "trainer.val_before_train=false",
      "trainer.logger=[console]",
      "actor_rollout_ref.actor.strategy=fsdp2",
      "actor_rollout_ref.actor.ppo_mini_batch_size=16",
      "actor_rollout_ref.rollout.name=vllm",
      "actor_rollout_ref.rollout.mode=async",
      "actor_rollout_ref.rollout.nnodes=4",
      "actor_rollout_ref.rollout.n_gpus_per_node=2",
      "actor_rollout_ref.rollout.free_cache_engine=false",
      "actor_rollout_ref.rollout.multi_turn.enable=false",
      "actor_rollout_ref.rollout.n=1"
    ]
  }
}
